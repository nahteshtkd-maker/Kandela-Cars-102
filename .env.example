# --- Server ---
NODE_ENV=development
PORT=3000

# --- Auth ---
# Required in production. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: control the very first admin account created on first boot.
# If omitted, a random one-time password is generated and printed to the
# server console on first run, and the admin is forced to change it at login.
ADMIN_INITIAL_EMAIL=admin@kandelacars.et
ADMIN_INITIAL_PASSWORD=

# --- CORS ---
# Comma-separated list of origins allowed to call the API with credentials.
# Leave both empty in local dev (same-origin requests are always allowed).
# Fill these in once the public site and admin dashboard are deployed to
# separate origins/subdomains.
ALLOWED_PUBLIC_ORIGIN=
ALLOWED_ADMIN_ORIGIN=

# --- Customer authentication ---
# Google Sign-In: create an OAuth Client ID (Web application) in Google Cloud
# Console → APIs & Services → Credentials. No client secret needed — this flow
# only verifies ID tokens. Same value goes in both of these:
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Phone OTP: without these set, verification codes are logged to the server
# console instead of sent by SMS (fine for dev/testing, not for production).
# Get these from console.twilio.com after creating a Twilio account:
#   TWILIO_ACCOUNT_SID  — Account SID, on the Twilio Console dashboard
#   TWILIO_AUTH_TOKEN   — Auth Token, same dashboard (click to reveal)
#   TWILIO_FROM_NUMBER  — a Twilio phone number capable of sending SMS,
#                          purchased under Phone Numbers → Buy a Number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Reserved for a future managed-cloud phase (Postgres/Supabase/Firebase/
# object storage) — not used by the current server, kept here so the env file
# documents where those secrets will eventually live. ---
# DATABASE_URL=
# AUTH_PROVIDER_SECRET=
# STORAGE_SERVICE_SECRET=
# SENTRY_DSN=
